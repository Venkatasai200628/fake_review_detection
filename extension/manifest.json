{
  "manifest_version": 3,
  "name": "Review Photo Forensics",
  "version": "0.1.0",
  "description": "Flags suspicious product reviews by checking their photos (edited? reused by other accounts?) together with text and rating. Runs against a local backend only.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.app.github.dev/*",
    "https://*.azurecontainerapps.io/*",
    "https://*.azurewebsites.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*",
        "https://www.amazon.com/*",
        "https://www.flipkart.com/*",
        "https://www.meesho.com/*",
        "https://meesho.com/*",
        "http://127.0.0.1:8000/demo*",
        "http://localhost:8000/demo*"
      ],
      "js": [
        "sites.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}